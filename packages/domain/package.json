{
  "name": "@perdida-peso/domain",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./bmr": {
      "types": "./dist/bmr.d.ts",
      "default": "./dist/bmr.js"
    },
    "./xp": {
      "types": "./dist/xp.d.ts",
      "default": "./dist/xp.js"
    },
    "./levels": {
      "types": "./dist/levels.d.ts",
      "default": "./dist/levels.js"
    },
    "./retention": {
      "types": "./dist/retention.d.ts",
      "default": "./dist/retention.js"
    },
    "./hydration": {
      "types": "./dist/hydration.d.ts",
      "default": "./dist/hydration.js"
    },
    "./weeks": {
      "types": "./dist/weeks.d.ts",
      "default": "./dist/weeks.js"
    }
  },
  "files": ["dist", "src", "package.json"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@perdida-peso/config": "workspace:*",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
