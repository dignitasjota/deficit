{
  "name": "@perdida-peso/api-client",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "package.json"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "generate": "openapi-typescript http://localhost:3001/docs-json -o src/generated/schema.d.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@perdida-peso/schemas": "workspace:*"
  },
  "devDependencies": {
    "@perdida-peso/config": "workspace:*",
    "eslint": "^9.17.0",
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.7.2"
  }
}
