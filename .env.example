### ─── Postgres ──────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=perdida_peso

### ─── API ──────────────────────────────────────────────────────
NODE_ENV=production
DATABASE_URL=postgres://postgres:postgres@db:5432/perdida_peso
CORS_ORIGINS=https://app.example.com
SWAGGER_ENABLED=false
LOG_LEVEL=info

### ─── Auth (Fase 3). Generar con: openssl rand -base64 48 ──────
JWT_SECRET=cambiame_en_produccion_min_32_chars_xxxxxxxxxxxxxxxx
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

### ─── URLs públicas (Fases 14, 17, 20) ─────────────────────────
# Frontend (links de emails, success_url de Stripe Checkout)
APP_URL=https://app.example.com
# Web → API en build-time (se inyecta en el bundle Next)
NEXT_PUBLIC_API_URL=https://api.example.com
# Dominio público de la landing (sitemap, robots, OG, JSON-LD).
# Fallback en código: https://deficit.app
NEXT_PUBLIC_SITE_URL=https://deficit.app
# Token de verificación de Google Search Console (opcional, se
# obtiene desde Search Console → Verificación → Etiqueta HTML).
# Si no está definido, no se renderiza el meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

### ─── SMTP (Fase 14). En dev: mailpit. En prod: Resend/SES/postal
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="Pérdida-Peso <noreply@perdida-peso.local>"

### ─── Soft-delete (Fase 14) ────────────────────────────────────
PURGE_GRACE_DAYS=30

### ─── Stripe (Fase 17). Vacíos = billing desactivado ───────────
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_TRIAL_DAYS=14

### ─── Bootstrap admin (Fase 15) ────────────────────────────────
# Si lo defines, ese email se promueve a admin automáticamente al
# arrancar la API (idempotente). Útil para Portainer.
BOOTSTRAP_ADMIN_EMAIL=

### ─── MinIO (object storage para avatares y CSV) ───────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=cambiame_en_produccion
