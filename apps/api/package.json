{
  "name": "@perdida-peso/api",
  "version": "0.0.0",
  "private": true,
  "description": "API REST de pérdida-peso (NestJS)",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^3.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/terminus": "^11.0.0",
    "@perdida-peso/domain": "workspace:*",
    "@perdida-peso/schemas": "workspace:*",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "cache-manager": "^6.4.0",
    "drizzle-orm": "^0.38.3",
    "drizzle-zod": "^0.6.1",
    "nestjs-pino": "^4.2.0",
    "nodemailer": "^6.9.16",
    "stripe": "^17.4.0",
    "nestjs-zod": "^4.3.1",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@perdida-peso/config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
