NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/perdida_peso
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
LOG_LEVEL=debug

# Generar con: openssl rand -base64 48
JWT_SECRET=cambiar_en_produccion_min_32_chars_xxxxxxxxxxxxxxxx
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# URL pública del frontend (links de emails).
APP_URL=http://localhost:3000

# SMTP — en dev apunta al servicio mailpit del docker-compose.
# En prod sustituir por Resend SMTP, SES, postal, etc.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="Déficit <noreply@perdida-peso.local>"

# Días de gracia entre soft-delete y hard-purge.
PURGE_GRACE_DAYS=30

# Stripe (Fase 17). Vacíos = billing desactivado.
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# IDs de precios creados en el dashboard de Stripe (price_xxx).
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Días de trial sin tarjeta al registrarse. 0 desactiva el trial.
STRIPE_TRIAL_DAYS=14
